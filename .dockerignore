# Git
.git
.gitignore

# Documentation
README.md
LICENSE
docs/
docs/assets/

# CI/CD
.github/

# Business and local tooling assets not needed at runtime
evals/
fixes/
scripts/
# backend/scripts/ IS shipped (the agent-mesh cron Job runs from it), but local
# scratch notes/handoff prompts living alongside it must never enter the image.
backend/scripts/*.md
backend/scripts/*.prompt.md

# IDE and editor files
.vscode/
.idea/
*.swp
*.swo
*~

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Dependencies (installed inside container)
node_modules/
frontend/node_modules/
backend/node_modules/
.npm
.yarn/

# Build outputs (built inside container) 
dist/
build/
frontend/static/
frontend/dist/
backend/static/
backend/dist/
static/

# Logs
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Runtime data
pids
*.pid
*.seed
*.pid.lock
data/*
!data/exercises/
!data/exercises/**
!data/learning/
!data/learning/**
!data/images/
!data/images/**
*.db
*.db-journal
*.db-wal
*.db-shm

# azd / local state
.azure/
$TMPDIR/
frontend/$TMPDIR/
**/$TMPDIR/

# Coverage directory used by tools like istanbul
coverage/
*.lcov
.nyc_output

# Environment files (use docker-compose or --env-file)
.env*
!.env.example

# Python cache
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
ENV/
env.bak/
venv.bak/
.venv/
**/.venv/
backend/.venv/
.mypy_cache/

# Temporary files
*.tmp
*.temp
.cache/
.parcel-cache

# Development containers
.devcontainer/

# Testing
.pytest_cache/

# Linting cache
.eslintcache
.stylelintcache

# Docker files (don't include in build context)
Dockerfile*
docker-compose*.yml
.dockerignore
config/docker/
backup_*/